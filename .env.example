# Corvanta backend environment template
# DEVELOPMENT PLACEHOLDER — REPLACE BEFORE PRODUCTION

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/corvanta_dev

JWT_ACCESS_SECRET=development-placeholder-change-this
JWT_REFRESH_SECRET=development-placeholder-change-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=10

RESEND_API_KEY=development-placeholder-resend-key

CLOUDINARY_CLOUD_NAME=development-placeholder-cloud-name
CLOUDINARY_API_KEY=development-placeholder-cloud-key
CLOUDINARY_API_SECRET=development-placeholder-cloud-secret

# === AI Configuration ===

# Select AI provider: "mock" (default, no API key needed) or "openai"
AI_PROVIDER=mock

# Required for real OpenAI calls. Replace placeholder with your actual key.
# Server refuses to start in production if this is still a placeholder.
OPENAI_API_KEY=development-placeholder-openai-key

# Optional: OpenAI organization ID
OPENAI_ORGANIZATION=

# Request timeout in milliseconds (default: 10000)
AI_PROVIDER_TIMEOUT_MS=10000

# Maximum retry attempts for transient provider failures (default: 2)
AI_MAX_RETRIES=2

# Base delay in ms for exponential backoff on retries (default: 1000)
AI_RETRY_BASE_DELAY_MS=1000

# Maximum character limit for user message (default: 20000)
AI_USER_MESSAGE_MAX_CHARS=20000

# Maximum total system prompt + context characters (default: 60000)
AI_MAX_PROMPT_CHARS=60000

# Maximum number of retrieved documents in context (default: 10)
AI_MAX_CONTEXT_DOCUMENTS=10

# AI conversation rate limit per company (requests per window)
AI_CONVERSATION_RATE_LIMIT_WINDOW_MS=60000
AI_CONVERSATION_RATE_LIMIT_MAX=30

# === Generation Limits ===

# Maximum conversation history messages (default: 20)
AI_HISTORY_MESSAGE_LIMIT=20

# Maximum retrieved context documents for non-semantic retrieval (default: 5)
AI_CONTEXT_DOCUMENT_LIMIT=5

# Maximum total context characters (default: 12000)
AI_CONTEXT_MAX_CHARS=12000

# Maximum messages per list response (default: 50)
AI_MESSAGE_LIST_LIMIT=50

# Maximum output tokens per AI response (default: 1024)
AI_MAX_OUTPUT_TOKENS=1024

# === Provider/Model Allowlists ===

# Comma-separated list of allowed providers (default: mock,openai)
AI_ALLOWED_PROVIDERS=mock,openai

# Comma-separated list of allowed generation models (default: mock-model,gpt-4o-mini,gpt-4o,gpt-4.1-mini,gpt-3.5-turbo)
AI_ALLOWED_GENERATION_MODELS=mock-model,gpt-4o-mini,gpt-4o,gpt-4.1-mini,gpt-3.5-turbo

# === Embedding Configuration ===

# Select embedding provider: "mock" (default) or "openai"
AI_EMBEDDING_PROVIDER=mock

# Comma-separated list of allowed embedding models (default: mock-embedding-model,text-embedding-3-small,text-embedding-3-large)
AI_ALLOWED_EMBEDDING_MODELS=mock-embedding-model,text-embedding-3-small,text-embedding-3-large

# Default embedding model (default: text-embedding-3-small)
AI_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Default embedding dimensions (default: 1536)
AI_DEFAULT_EMBEDDING_DIMENSIONS=1536

# === Vector Store Configuration ===

# Select vector store provider: "memory" (default, in-memory), "persistent-mongodb" (default for RAG), or "pinecone" (production opt-in)
AI_VECTOR_STORE=memory

# --- Pinecone (production opt-in) ---
# Set AI_VECTOR_STORE=pinecone to use the PineconeVectorStore provider.
# This provider makes real HTTPS calls to api.pinecone.io and requires a live Pinecone index.
# It is intentionally NOT the default; local development and CI tests use the in-memory provider.

# Pinecone API key (required when AI_VECTOR_STORE=pinecone). Keep secret out of source control.
PINECONE_API_KEY=

# Pinecone index name (required when AI_VECTOR_STORE=pinecone).
PINECONE_INDEX=

# Optional Pinecone namespace for tenant/data isolation within the index.
PINECONE_NAMESPACE=

# Optional Pinecone server host override (defaults to https://api.pinecone.io).
PINECONE_HOST=

# Optional request timeout in milliseconds (default: 10000).
PINECONE_TIMEOUT_MS=10000

# Optional vector dimensions override (defaults to AI_DEFAULT_EMBEDDING_DIMENSIONS).
PINECONE_DIMENSIONS=

# === Document Chunking ===

CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
CHUNK_MAX_CHARS=4000
